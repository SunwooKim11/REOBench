.venv

# ---- generated files ----
__pycache__/
*.pyc
*.pth
*.pt
*.pkl
*.log
logs/
repro/experiments/*/cache/
repro/experiments/*/work_dirs/
repro/experiments/*/results/**/log.txt
repro/third_party/cotta_acdc_svdp/work_dirs/

# ---- vendored third-party copies: keep only our scripts and the files we patched ([REOBench] / [REOBench repro]) ----
# Official CoTTA repo, run as is (patch documented in repro/review/diffs/cotta_official_run.diff)
repro/third_party/cotta_official/**
!repro/third_party/cotta_official/**/
!repro/third_party/cotta_official/imagenet/run_official.sh
!repro/third_party/cotta_official/imagenet/cotta.py
!repro/third_party/cotta_official/imagenet/cfgs/std_*.yaml

# SVDP copy of CoTTA's ACDC code (patches listed in repro/third_party/cotta_acdc_svdp/README_REOBench.md; diffs in repro/review/diffs/seg__*)
repro/third_party/cotta_acdc_svdp/**
!repro/third_party/cotta_acdc_svdp/**/
!repro/third_party/cotta_acdc_svdp/*.sh
!repro/third_party/cotta_acdc_svdp/README_REOBench.md
!repro/third_party/cotta_acdc_svdp/mmseg/__init__.py
!repro/third_party/cotta_acdc_svdp/mmseg/apis/__init__.py
!repro/third_party/cotta_acdc_svdp/mmseg/apis/test.py
!repro/third_party/cotta_acdc_svdp/mmseg/models/segmentors/encoder_decoder.py
!repro/third_party/cotta_acdc_svdp/tools/tent.py
!repro/third_party/cotta_acdc_svdp/tools/tent_entropy.py
!repro/third_party/cotta_acdc_svdp/tools/cotta.py
!repro/third_party/cotta_acdc_svdp/local_configs/_base_/datasets/acdc_1024x1024_repeat.py

# Copy of REOBench/Segmentation (the original is tracked at Segmentation/); keep patched files + our configs
repro/third_party/reobench_seg/**
!repro/third_party/reobench_seg/**/
!repro/third_party/reobench_seg/configs/repro/*.py
!repro/third_party/reobench_seg/mmseg/__init__.py
!repro/third_party/reobench_seg/mmseg/models/builder.py
!repro/third_party/reobench_seg/mmseg/models/backbones/scale_MAE_vit_large.py
!repro/third_party/reobench_seg/mmseg/models/backbones/SatMAE_vit_large.py
!repro/third_party/reobench_seg/mmseg/datasets/pipelines/loading.py

# ---- papers (copyrighted PDFs, local reading only) ----
papers/
