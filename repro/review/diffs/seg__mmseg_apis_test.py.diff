+def single_gpu_tent_entropy(model,
+                            data_loader,
+                            show=False,
+                            out_dir=None,
+                            efficient_test=False):
+    """[REOBench] Tent as in the original paper / DequanWang/tent: minimize the Shannon entropy of the predictions
+    (here per pixel, averaged over the image). Everything else is identical to single_gpu_tent above (the CoTTA
+    codebase "TENT", which instead uses cross-entropy on its own argmax prediction): same parameters ("norm"/"bn"),
+    Adam 6e-5/8, batch 1, prediction made before the update, model in eval() mode."""
+    model.eval()
+    import os
+    bn_batch = os.environ.get("TENT_BN", "fixed") == "batch"
+    if bn_batch:  # original Tent configure_model: BN normalizes with the test batch statistics (here: one image)
+        for m in model.modules():
+            if isinstance(m, torch.nn.modules.batchnorm._BatchNorm):
+                m.train()
+                m.track_running_stats = False
+                m.running_mean = None
+                m.running_var = None
+    print(f"[tent_entropy] BN statistics: {'test batch' if bn_batch else 'fixed (running stats, as in the CoTTA code)'}")
+    results = []
+    dataset = data_loader.dataset
+    prog_bar = mmcv.ProgressBar(len(dataset))
+    param_list = []
+    for name, param in model.named_parameters():
+        if param.requires_grad:
+            if param.requires_grad and ("norm" in name or "bn" in name):
+                param_list.append(param)
+            else:
+                param.requires_grad=False
+    optimizer = torch.optim.Adam(param_list, lr=0.00006/8, betas=(0.9, 0.999))
+    seg = model.module
+    for i, data in enumerate(data_loader):
+        with torch.no_grad():
+            result = model(return_loss=False, **data)
+        if efficient_test:
+            result = [np2tmp(_) for _ in result]
+        results.extend(result)
+
+        img = data['img'][0].cuda()
+        img_metas = data['img_metas'][0].data[0]
+        logits = seg.decode_head(seg.extract_feat(img, img_metas))       # 1/4 resolution
+        logits = resize(logits, size=img.shape[2:], mode='bilinear', align_corners=seg.align_corners)
+        loss = -(logits.softmax(1) * logits.log_softmax(1)).sum(1).mean()  # = softmax_entropy, mean over pixels
+        loss.backward()
+        optimizer.step()
+        optimizer.zero_grad()
+
+        batch_size = data['img'][0].size(0)
+        for _ in range(batch_size):
+            prog_bar.update()
+    return results
